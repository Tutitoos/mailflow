{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailflow",
  "version": "0.1.0",
  "identifier": "dev.tutitoos.mailflow",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev",
    "devUrl": "http://127.0.0.1:4310"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mailflow"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A private, self-hosted email client",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
