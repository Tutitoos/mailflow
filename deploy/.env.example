MAILFLOW_DOMAIN=mail.example.com
ACME_EMAIL=admin@example.com
# Leave image variables unset for local builds. Production releases pin each
# value to the digest recorded in container-release-manifest.json.
MAILFLOW_WEB_IMAGE=
MAILFLOW_AUTH_IMAGE=
MAILFLOW_API_IMAGE=
MAILFLOW_WORKER_IMAGE=
MAILFLOW_BACKUP_IMAGE=
BACKUP_PATH=./backups
RESTIC_REPOSITORY=/repository
MAILFLOW_BACKUP_ENABLED=true
MAILFLOW_BACKUP_SCHEDULE=03:00
MAILFLOW_BACKUP_TIMEZONE=UTC
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_AUTHORITY=common
VITE_SENTRY_DSN=
MAILFLOW_SENTRY_REPLAY_ENABLED=false
MAILFLOW_ALERT_SMTP_HOST=
MAILFLOW_ALERT_SMTP_PORT=587
MAILFLOW_ALERT_SMTP_USERNAME=
MAILFLOW_ALERT_SMTP_FROM=
MAILFLOW_ALERT_SMTP_TO=
MAILFLOW_ALERT_SMTP_IMPLICIT_TLS=false
MAILFLOW_ALERT_CONNECTED_ACCOUNT_FALLBACK=false
MAILFLOW_IMAP_ACCOUNT_REFRESH=30s
MAILFLOW_IMAP_IDLE_HEARTBEAT=25m
MAILFLOW_IMAP_POLL_INTERVAL=5m
MAILFLOW_IMAP_RECONNECT_MIN=1s
MAILFLOW_IMAP_RECONNECT_MAX=1m
MAILFLOW_IMAP_LEASE_RENEW=30s
MAILFLOW_IMAP_BURST_WINDOW=1s
MAILFLOW_IMAP_MAX_CONNECTIONS=4
