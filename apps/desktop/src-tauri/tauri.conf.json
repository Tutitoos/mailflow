{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailflow",
  "version": "0.1.0",
  "identifier": "dev.mailflow.app",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev",
    "devUrl": "http://127.0.0.1:4310",
    "beforeBuildCommand": "bun run --cwd ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mailflow",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A private, self-hosted email client",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
