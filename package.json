{
  "name": "mailflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/auth"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd services/auth typecheck && bun run --cwd packages/api-client typecheck",
    "generate": "bun run --cwd packages/api-client generate",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun run --cwd apps/web test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2"
  }
}
